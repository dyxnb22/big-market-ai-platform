# Shared parameterized Dockerfile for all Spring Boot microservices.
# Usage: docker build --build-arg MODULE_NAME=big-market-auth-service -t big-market-auth-service .
FROM eclipse-temurin:8-jre

ARG MODULE_NAME
ENV PARAMS=""
ENV JAVA_OPTS=""
ENV TZ=Asia/Shanghai

RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

ADD ${MODULE_NAME}/target/${MODULE_NAME}.jar /app.jar

ENTRYPOINT ["sh", "-c", "java -jar $JAVA_OPTS /app.jar $PARAMS"]
