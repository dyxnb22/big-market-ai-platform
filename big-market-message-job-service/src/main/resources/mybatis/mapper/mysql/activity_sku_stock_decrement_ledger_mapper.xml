<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dyx.market.infrastructure.dao.IActivitySkuStockDecrementLedgerDao">

    <resultMap id="dataMap" type="com.dyx.market.infrastructure.dao.po.ActivitySkuStockDecrementLedger">
        <id column="id" property="id"/>
        <result column="sku" property="sku"/>
        <result column="activity_id" property="activityId"/>
        <result column="lock_surplus" property="lockSurplus"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <insert id="insert" parameterType="com.dyx.market.infrastructure.dao.po.ActivitySkuStockDecrementLedger">
        insert into activity_sku_stock_decrement_ledger(
            sku, activity_id, lock_surplus, status, create_time, update_time
        ) values (
            #{sku}, #{activityId}, #{lockSurplus}, 'applied', now(), now()
        )
    </insert>

    <select id="queryBySkuAndLockSurplus" parameterType="com.dyx.market.infrastructure.dao.po.ActivitySkuStockDecrementLedger" resultMap="dataMap">
        select id, sku, activity_id, lock_surplus, status, create_time, update_time
        from activity_sku_stock_decrement_ledger
        where sku = #{sku} and lock_surplus = #{lockSurplus}
        limit 1
    </select>

</mapper>
