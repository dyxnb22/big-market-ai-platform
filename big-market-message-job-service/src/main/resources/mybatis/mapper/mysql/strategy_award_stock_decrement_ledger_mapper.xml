<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dyx.market.infrastructure.dao.IStrategyAwardStockDecrementLedgerDao">

    <resultMap id="dataMap" type="com.dyx.market.infrastructure.dao.po.StrategyAwardStockDecrementLedger">
        <id column="id" property="id"/>
        <result column="reservation_id" property="reservationId"/>
        <result column="strategy_id" property="strategyId"/>
        <result column="award_id" property="awardId"/>
        <result column="lock_surplus" property="lockSurplus"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <insert id="insert" parameterType="com.dyx.market.infrastructure.dao.po.StrategyAwardStockDecrementLedger">
        insert into strategy_award_stock_decrement_ledger(
            reservation_id, strategy_id, award_id, lock_surplus, status, create_time, update_time
        ) values (
            #{reservationId}, #{strategyId}, #{awardId}, #{lockSurplus}, 'applied', now(), now()
        )
    </insert>

    <select id="queryByReservationId" resultMap="dataMap">
        select id, reservation_id, strategy_id, award_id, lock_surplus, status, create_time, update_time
        from strategy_award_stock_decrement_ledger
        where reservation_id = #{reservationId}
        limit 1
    </select>

</mapper>
